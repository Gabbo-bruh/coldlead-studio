{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Gabbo-bruh/coldlead-studio/main/schema/pos-lead-dossier.schema.json",
  "$defs": {
    "ActionKit": {
      "properties": {
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "vibe_opportunity_summary": {
          "title": "Vibe Opportunity Summary",
          "type": "string"
        },
        "loom_script_90s": {
          "title": "Loom Script 90S",
          "type": "string"
        },
        "cold_email_subject": {
          "title": "Cold Email Subject",
          "type": "string"
        },
        "cold_email": {
          "title": "Cold Email",
          "type": "string"
        },
        "whatsapp_opener": {
          "title": "Whatsapp Opener",
          "type": "string"
        },
        "vibecoding_prompt": {
          "title": "Vibecoding Prompt",
          "type": "string"
        },
        "generated_by": {
          "default": "templates",
          "title": "Generated By",
          "type": "string"
        }
      },
      "required": [
        "vibe_opportunity_summary",
        "loom_script_90s",
        "cold_email_subject",
        "cold_email",
        "whatsapp_opener",
        "vibecoding_prompt"
      ],
      "title": "ActionKit",
      "type": "object"
    },
    "Company": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "niche": {
          "default": "",
          "title": "Niche",
          "type": "string"
        },
        "city": {
          "default": "",
          "title": "City",
          "type": "string"
        },
        "address": {
          "default": "",
          "title": "Address",
          "type": "string"
        },
        "phone": {
          "default": "",
          "title": "Phone",
          "type": "string"
        },
        "email": {
          "default": "",
          "title": "Email",
          "type": "string"
        },
        "vat_number": {
          "default": "",
          "title": "Vat Number",
          "type": "string"
        },
        "legal_form": {
          "$ref": "#/$defs/LegalForm",
          "default": "Unknown"
        },
        "employees_estimate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employees Estimate"
        },
        "direct_contact_person": {
          "default": "",
          "title": "Direct Contact Person",
          "type": "string"
        },
        "contact_channels": {
          "items": {
            "type": "string"
          },
          "title": "Contact Channels",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Company",
      "type": "object"
    },
    "Enrichment": {
      "description": "Qualitative insights (heuristic or LLM generated).",
      "properties": {
        "vibe_opportunity_summary": {
          "default": "",
          "title": "Vibe Opportunity Summary",
          "type": "string"
        },
        "psychological_lever": {
          "default": "",
          "title": "Psychological Lever",
          "type": "string"
        },
        "enriched_by": {
          "default": "heuristic",
          "title": "Enriched By",
          "type": "string"
        }
      },
      "title": "Enrichment",
      "type": "object"
    },
    "LegalForm": {
      "enum": [
        "S.p.A.",
        "S.r.l.",
        "S.r.l.s.",
        "S.n.c. / S.a.s.",
        "Soc. Coop.",
        "Ditta Individuale",
        "Studio Professionale",
        "Ltd / LLC / GmbH",
        "Unknown"
      ],
      "title": "LegalForm",
      "type": "string"
    },
    "POSEvaluation": {
      "properties": {
        "final_score": {
          "title": "Final Score",
          "type": "number"
        },
        "raw_score": {
          "title": "Raw Score",
          "type": "number"
        },
        "uncapped_score": {
          "title": "Uncapped Score",
          "type": "number"
        },
        "tier": {
          "title": "Tier",
          "type": "string"
        },
        "tier_code": {
          "$ref": "#/$defs/Tier"
        },
        "is_discarded": {
          "title": "Is Discarded",
          "type": "boolean"
        },
        "discard_reasons": {
          "items": {
            "$ref": "#/$defs/RedFlag"
          },
          "title": "Discard Reasons",
          "type": "array"
        },
        "variables": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Variables",
          "type": "object"
        },
        "explanations": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Explanations",
          "type": "object"
        },
        "weights_applied": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Weights Applied",
          "type": "object"
        },
        "multipliers_applied": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Multipliers Applied",
          "type": "object"
        },
        "preset": {
          "title": "Preset",
          "type": "string"
        },
        "season": {
          "title": "Season",
          "type": "string"
        },
        "recommendation": {
          "title": "Recommendation",
          "type": "string"
        }
      },
      "required": [
        "final_score",
        "raw_score",
        "uncapped_score",
        "tier",
        "tier_code",
        "is_discarded",
        "variables",
        "weights_applied",
        "multipliers_applied",
        "preset",
        "season",
        "recommendation"
      ],
      "title": "POSEvaluation",
      "type": "object"
    },
    "RawSignals": {
      "description": "Objective signals collected once by providers and auditors.\n\n``None`` always means *unknown*: the scoring engine treats it as neutral and says so.",
      "properties": {
        "has_website": {
          "default": false,
          "title": "Has Website",
          "type": "boolean"
        },
        "website_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Website Url"
        },
        "lighthouse_performance": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lighthouse Performance"
        },
        "performance_source": {
          "anyOf": [
            {
              "enum": [
                "lighthouse",
                "estimated",
                "provided"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Performance Source"
        },
        "mobile_friendly": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mobile Friendly"
        },
        "has_ssl": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Ssl"
        },
        "cms_stack": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cms Stack"
        },
        "has_multilingual": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Multilingual"
        },
        "has_booking_system": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Booking System"
        },
        "has_ai_chat": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Ai Chat"
        },
        "has_pdf_menu": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Pdf Menu"
        },
        "has_contact_form": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Contact Form"
        },
        "footer_agency_credit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footer Agency Credit"
        },
        "page_weight_kb": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Weight Kb"
        },
        "response_time_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Time Ms"
        },
        "reviews_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviews Count"
        },
        "average_rating": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Rating"
        },
        "owner_reply_rate": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Reply Rate"
        },
        "owner_sentiment_tone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Sentiment Tone"
        },
        "is_toxic_owner": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Toxic Owner"
        },
        "sample_owner_replies": {
          "items": {
            "type": "string"
          },
          "title": "Sample Owner Replies",
          "type": "array"
        },
        "is_running_ads": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Running Ads"
        },
        "ads_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Ads Evidence",
          "type": "array"
        },
        "is_chain": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Chain"
        },
        "business_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Status"
        },
        "international_clientele": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "International Clientele"
        },
        "competitor_pressure": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Competitor Pressure"
        },
        "competitor_notes": {
          "default": "",
          "title": "Competitor Notes",
          "type": "string"
        },
        "ticket_value_hint": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ticket Value Hint"
        }
      },
      "title": "RawSignals",
      "type": "object"
    },
    "RedFlag": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM"
          ],
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "description"
      ],
      "title": "RedFlag",
      "type": "object"
    },
    "Tier": {
      "enum": [
        "hot",
        "warm",
        "cold",
        "red_flag"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "description": "The standardized output record shared by every surface (CLI, web, MCP, exports).",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "rank": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rank"
    },
    "company": {
      "$ref": "#/$defs/Company"
    },
    "raw_signals": {
      "$ref": "#/$defs/RawSignals"
    },
    "enrichment": {
      "$ref": "#/$defs/Enrichment"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "pos_evaluation": {
      "$ref": "#/$defs/POSEvaluation"
    },
    "action_kit": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionKit"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "company",
    "raw_signals",
    "enrichment",
    "source",
    "pos_evaluation"
  ],
  "title": "LeadDossier",
  "type": "object"
}