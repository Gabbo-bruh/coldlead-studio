# ColdLead Studio — every variable is optional. Copy to .env (git-ignored) and fill what you need.
# `coldlead doctor` shows which capabilities are active.

# --- Discovery ------------------------------------------------------------------------------
# Google Places API (New). Without it, `--source auto` uses OpenStreetMap (free) then demo data.
GOOGLE_PLACES_API_KEY=

# --- Audits ---------------------------------------------------------------------------------
# Official Lighthouse scores via PageSpeed Insights (also works key-less with --pagespeed, rate-limited).
PAGESPEED_API_KEY=
# Verify active ads in the Meta Ad Library.
META_AD_LIBRARY_ACCESS_TOKEN=

# --- LLM insights & copy polish (first key found wins, or force a provider) -----------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# COLDLEAD_LLM_PROVIDER=auto        # auto | gemini | anthropic | openrouter | openai | ollama | none
# COLDLEAD_LLM_MODEL=               # override the provider's default model
# COLDLEAD_LLM_BASE_URL=            # OpenAI-compatible endpoint (LM Studio, vLLM, Ollama…)

# --- Preferences ----------------------------------------------------------------------------
# COLDLEAD_LANG=it                  # outreach language: it | en
# COLDLEAD_COUNTRY=IT               # Meta Ad Library country
# COLDLEAD_PRESET=default_vibe_coding
# COLDLEAD_SEASON=auto              # auto | autumn_winter | spring | summer_peak | year_round
# COLDLEAD_W_A=2.0                  # any weight: COLDLEAD_W_G … COLDLEAD_W_A
# COLDLEAD_HOME=~/.coldlead         # sessions and config.json location
